# Copy to .env.local. Values here are local stand-ins; real keys come with the accounts (plan phase 0).
VITE_SITE_ID=rpcc

# Local Docker Postgres (pnpm db:up); use cc_dnz for the other site.
DATABASE_URL=postgres://cc:cc@localhost:5433/cc_rpcc
DATABASE_DRIVER=pg

# openssl rand -base64 32
BETTER_AUTH_SECRET=replace-with-32-plus-random-characters-000
BETTER_AUTH_URL=http://localhost:3000
PSEUDONYM_SECRET=replace-with-32-plus-random-characters-111

# Optional: missing keys switch the adapter to its local stand-in.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
RESEND_API_KEY=
RESEND_WEBHOOK_SECRET=
EMAIL_FROM="Creative Cluster <noreply@localhost>"
EMAIL_DAILY_CAP=100
# Cloudflare's always-pass test keys.
TURNSTILE_SECRET_KEY=1x0000000000000000000000000000000AA
VITE_TURNSTILE_SITE_KEY=1x00000000000000000000AA
GEOAPIFY_API_KEY=
GEOCODER_CONTACT=admin@localhost
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_AI_TOKEN=
CLOUDINARY_CLOUD_NAME=
SENTRY_DSN=
VITE_SENTRY_DSN=
VITE_POSTHOG_KEY=
CLIENT_IP_HEADER=x-nf-client-connection-ip
