{
  "name": "creative-cluster",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@12.8.1",
  "scripts": {
    "dev": "vite dev --port 3000",
    "dev:dnz": "cross-env VITE_SITE_ID=dnz vite dev --port 3001",
    "build": "vite build",
    "build:rpcc": "cross-env VITE_SITE_ID=rpcc vite build",
    "build:dnz": "cross-env VITE_SITE_ID=dnz vite build",
    "analyze": "cross-env ANALYZE=true VITE_SITE_ID=rpcc vite build",
    "size": "size-limit",
    "preview": "vite preview",
    "lint": "pnpm generate && eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "typecheck": "pnpm generate && tsc --noEmit",
    "test": "pnpm generate && vitest run",
    "generate": "tsx scripts/generate.ts && tsr generate",
    "db:up": "docker compose up -d db",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate",
    "db:check": "drizzle-kit check",
    "admin:create": "tsx scripts/create-admin.ts",
    "seed:tags": "tsx scripts/seed-tags.ts",
    "seed:fake": "tsx scripts/seed-fake.ts",
    "seed:dev": "tsx scripts/assert-local-db.ts && pnpm seed:tags && pnpm seed:fake",
    "dgu:import": "tsx scripts/dgu-import.ts",
    "geonames:build": "tsx scripts/geonames-build.ts",
    "import:legacy-export": "tsx scripts/import-legacy-export.ts",
    "import:run": "tsx scripts/import-run.ts",
    "claims:prepare": "tsx scripts/claims-prepare.ts",
    "claims:send": "tsx scripts/claims-send.ts",
    "jobs:drain": "tsx scripts/drain-jobs.ts",
    "terms:notify": "tsx scripts/enqueue-terms-notice.ts",
    "maintenance:run": "tsx scripts/run-maintenance.ts",
    "email:dev": "email dev --dir src/emails --port 3020"
  },
  "dependencies": {
