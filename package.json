{
  "name": "creative-cluster",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@12.8.1",
  "scripts": {
    "dev": "vite dev --port 3000",
    "dev:dnz": "cross-env VITE_SITE_ID=dnz vite dev --port 3001",
    "build": "vite build",
    "build:rpcc": "cross-env VITE_SITE_ID=rpcc vite build",
    "build:dnz": "cross-env VITE_SITE_ID=dnz vite build",
    "preview": "vite preview",
    "lint": "pnpm generate && eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "typecheck": "pnpm generate && tsc --noEmit",
    "test": "vitest run",
    "generate": "tsx scripts/generate.ts && tsr generate",
    "db:up": "docker compose up -d db",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate",
    "db:check": "drizzle-kit check",
    "admin:create": "tsx scripts/create-admin.ts",
    "seed:tags": "tsx scripts/seed-tags.ts",
    "jobs:drain": "tsx scripts/drain-jobs.ts",
    "email:dev": "email dev --dir src/emails --port 3020"
  },
  "dependencies": {
    "@base-ui/react": "^1.9.0",
    "@fontsource-variable/geist": "^5.3.0",
    "@marsidev/react-turnstile": "^1.6.1",
    "@neondatabase/serverless": "1.2.0",
    "@netlify/functions": "^6.0.2",
    "@react-email/components": "^1.0.12",
    "@react-email/render": "^2.1.0",
    "@sindresorhus/slugify": "^3.0.1",
    "@t3-oss/env-core": "^0.13.11",
    "@tailwindcss/vite": "^4.3.3",
    "@tanstack/react-form": "^1.33.5",
    "@tanstack/react-query": "^5.104.1",
    "@tanstack/react-router": "1.170.42",
    "@tanstack/react-router-ssr-query": "^1.167.3",
    "@tanstack/react-start": "1.168.61",
    "@tanstack/react-table": "^9.2.8",
    "@tiptap/core": "^3.31.4",
    "@tiptap/extension-character-count": "^3.31.4",
    "@tiptap/extension-link": "^3.31.4",
    "@tiptap/pm": "^3.31.4",
    "@tiptap/react": "^3.31.4",
    "@tiptap/starter-kit": "^3.31.4",
    "@tiptap/static-renderer": "^3.31.4",
    "@zxcvbn-ts/core": "^4.2.0",
    "@zxcvbn-ts/language-common": "^4.1.3",
    "@zxcvbn-ts/language-en": "^4.1.1",
    "better-auth": "1.7.7",
    "class-variance-authority": "^0.7.1",
    "cn": "^0.4.0",
    "dequal": "^2.0.3",
    "drizzle-orm": "0.45.4",
    "image-size": "^2.0.4",
    "isbot": "^5.2.2",
    "lucide-react": "^1.55.0",
    "pg": "8.23.1",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-easy-crop": "^6.2.4",
    "resend": "^6.32.1",
    "shadcn": "^4.21.4",
    "sonner": "^2.0.8",
    "tailwindcss": "^4.3.3",
    "tw-animate-css": "^1.4.0",
    "uuid": "^14.0.3",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@inlang/paraglide-js": "2.27.0",
    "@netlify/vite-plugin-tanstack-start": "^1.3.19",
    "@react-email/ui": "^6.11.1",
    "@tanstack/eslint-plugin-query": "^5.104.1",
    "@tanstack/eslint-plugin-router": "^1.162.0",
    "@tanstack/router-cli": "^1.167.41",
    "@types/node": "^24.19.2",
    "@types/pg": "^8.23.1",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "cross-env": "^10.1.0",
    "dotenv": "^18.0.7",
    "drizzle-kit": "^0.31.11",
    "eslint": "^10.12.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-react-hooks": "^7.1.1",
    "globals": "^17.13.0",
    "jsdom": "^30.1.2",
    "prettier": "^3.9.10",
    "prettier-plugin-tailwindcss": "^0.8.1",
    "react-email": "^6.11.1",
    "tsx": "^4.23.15",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.71.1",
    "vite": "^8.3.4",
    "vitest": "^5.0.3"
  },
  "devEngines": {
    "runtime": {
      "name": "node",
      "version": "24.21.0",
      "onFail": "download"
    }
  }
