    "jsdom": "^30.1.3",
    "prettier": "^3.9.10",
    "prettier-plugin-tailwindcss": "^0.8.1",
    "proj4": "^2.22.0",
    "react-email": "^6.11.3",
    "rollup-plugin-visualizer": "^7.1.1",
    "saxes": "^6.0.0",
